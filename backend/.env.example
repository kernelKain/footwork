# Daily caps. Empty uses the code default. Higher values are clamped to the reviewed maximum.
# Install jobs: default 8, maximum 8. Global Gemma attempts: default 4, maximum 8.
# Global GPU seconds: default 240, maximum 480. Global music attempts: default 6, maximum 8.
# Raising the deployed global caps still requires provider-budget confirmation.
# deploy/render.yaml was not changed by the October 12, 2026 verification.
# That blueprint still lists GENERATION_ENABLED as false and global caps of 4, 240, and 6.
# The live dashboard is separate and remains user-controlled.
MAX_INSTALL_JOBS_PER_DAY=
MAX_MUSIC_ATTEMPTS_PER_DAY=
MAX_GEMMA_ATTEMPTS_PER_DAY=
MAX_GEMMA_GPU_SECONDS_PER_DAY=
HF_SPACE_URL=
HF_TOKEN=
GEMMA_MODEL_ID=
GEMMA_MODEL_REVISION=
ELEVENLABS_API_KEY=
