APP_ENV=
PUBLIC_BASE_URL=
ARTIFACT_DIR=
LEDGER_PATH=
GENERATION_ENABLED=
# Daily caps. Empty uses the code default. Higher values are clamped to the reviewed maximum.
# Install jobs: default 8, maximum 20. Global Gemma attempts: default 4, maximum 40.
# Global GPU seconds: default 240, maximum 2400. Global music attempts: default 6, maximum 40.
# deploy/render.yaml sets 20, 40, 2400, and 40. The live dashboard is separate.
# Apply the same four values there, then restart. GENERATION_ENABLED in the blueprint stays false.
MAX_INSTALL_JOBS_PER_DAY=
MAX_MUSIC_ATTEMPTS_PER_DAY=
MAX_GEMMA_ATTEMPTS_PER_DAY=
MAX_GEMMA_GPU_SECONDS_PER_DAY=
HF_SPACE_URL=
HF_TOKEN=
GEMMA_MODEL_ID=
GEMMA_MODEL_REVISION=
ELEVENLABS_API_KEY=
ELEVEN_MUSIC_MODEL=music_v2_5
